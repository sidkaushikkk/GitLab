# ==============================================================================
# GitLab Engineering Reliability Intelligence Platform — Backend Configuration
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=4000

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gitlab_intel
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=30000

# Frontend URL (Used for CORS origins and OAuth redirect target)
FRONTEND_URL=http://localhost:5173

# Cryptographic Session Configuration
# In production, SESSION_SECRET must be a cryptographically secure 32+ character random string
SESSION_SECRET=default-dev-session-secret-change-in-prod
SESSION_TTL_DAYS=7

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# At-Rest Token Encryption Key (AES-256-GCM requires exactly 32 bytes)
# In production, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_TOKEN_ENCRYPTION_KEY=default-dev-encryption-key-must-be-32-chars-long!

# Webhook Secrets for Inbound Repository Events
GITHUB_WEBHOOK_SECRET=default-github-webhook-secret-key-32chars!
GITLAB_WEBHOOK_TOKEN=default-gitlab-webhook-token-secret!

# Repository Ingestion & Storage Limits
STORAGE_PATH=./storage
MAX_FILE_SIZE_BYTES=1000000
GITHUB_FILE_FETCH_CONCURRENCY=5

# Live CVE / OSV Intelligence URLs
OSV_API_BATCH_URL=https://api.osv.dev/v1/querybatch
OSV_API_VULN_URL=https://api.osv.dev/v1/vulns

# API Rate Limiting (Requests per minute per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
