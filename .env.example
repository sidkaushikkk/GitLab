# ==============================================================================
# Docker Compose & Local Production-Like Environment Configuration
# ==============================================================================

# PostgreSQL Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gitlab_intel
POSTGRES_PORT=5432

# Backend Container Configuration
BACKEND_PORT=4000
NODE_ENV=production
SESSION_SECRET=enterprise-production-secure-session-secret-change-me-32chars!
GITHUB_TOKEN_ENCRYPTION_KEY=production-secret-encryption-key-must-be-32-chars-long!
FRONTEND_URL=http://localhost:8080

# Frontend Web Port
FRONTEND_PORT=8080
